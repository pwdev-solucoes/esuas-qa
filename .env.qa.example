# QA Repository Configuration
# Copy to .env.qa and edit as needed for your environment

# Repos (created/cloned by setup.sh)
REPOS_DIR=./repos
GIT_CLONE_DEPTH=1

# Backend (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=esuas_qa
DB_USERNAME=esuas
DB_PASSWORD=esuas_qa_pwd
REDIS_PASSWORD=null

# E2E Frontend URLs
E2E_BASE_URL=http://localhost:4173
E2E_API_URL=http://localhost:8090/api
E2E_API_BASE_URL=http://localhost:8090
CLIENT_BASE_URL=http://localhost:4174
E2E_MAILPIT_URL=http://localhost:8025

# E2E Authentication
E2E_ADMIN_CPF=44983702016
E2E_ADMIN_PASSWORD=senha123
E2E_CLIENT_OPERADOR_CPF=11144477735
E2E_CLIENT_MASTER_CPF=52998224725

# Playwright Configuration
PLAYWRIGHT_HEADED=false
PLAYWRIGHT_WORKERS=2
CI=false

# Optional: Override cache clear command for E2E
# Default: docker compose -f docker-compose.qa.yml -f e2e/docker-compose-e2e.yml exec -T app php artisan cache:clear
# For Sail dev mode: cd repos/api && ./vendor/bin/sail artisan cache:clear
# E2E_CACHE_CLEAR_CMD=
