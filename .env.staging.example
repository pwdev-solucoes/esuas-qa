# Staging/HML — copie para .env.staging (ignorado pelo git) e preencha os valores <...>.
# Lido por e2e/playwright.config.ts. Rode com: cd e2e && npm run e2e:staging
# Nomes STG_* de propósito: não colidem com E2E_* do stack local.

# --- URLs (sem barra final) ---
STG_ADMIN_URL=https://staging.manager.esuas.pwdev.com.br
STG_CLIENT_URL=https://staging.esuas.pwdev.com.br
STG_API_URL=https://staging.api.esuas.pwdev.com.br

# --- Super Admin do staging (já existente lá; quem cria a organização e o gestor) ---
STG_ADMIN_CPF=<cpf-do-super-admin, só dígitos>
STG_ADMIN_PASSWORD=<senha>

# --- Massa gerada a cada execução (CPF/CNPJ/e-mails são criados pelo teste) ---
# Prefixo dos nomes criados, para localizar e limpar depois no staging.
STG_DATA_PREFIX=E2E
# Senha que o gestor de teste define pelo e-mail (opcional; sem isso o teste gera uma).
# STG_MANAGER_PASSWORD=

# --- Caixa de e-mail descartável (o staging envia e-mail de verdade) ---
# Sem STG_MAILBOX_URL tenta https://api.mail.tm e, se estiver fora, https://api.mail.gw.
# STG_MAILBOX_URL=https://api.mail.tm
# Quanto esperar cada e-mail chegar (ms).
STG_MAIL_TIMEOUT_MS=120000
