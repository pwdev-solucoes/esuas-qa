        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"follow-up-attention-row-\"]:has-text(\"E2E Atenção A5 \")"
          },
          "note": "A5 listada (CA01)"
        },
        {
          "expect": "count",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"follow-up-attention-row-\"]:has-text(\"E2E Atenção A6 \")"
          },
          "value": 0,
          "note": "A6 em dia não entra (CA01)"
