        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"follow-up-attention-row-\"]:has([data-testid=\"attention-reason-without_plan\"]):has([data-testid=\"attention-reason-without_attendance\"])"
          },
          "note": "linha com os dois motivos (CA02)"
        }
