    "base_url_env": "CLIENT_BASE_URL",
    "start_path": "/login",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "users": [
      {
        "role": "operador_cras",
        "credentials_env": {
          "cpf": "E2E_CLIENT_OPERADOR_CPF",
          "password": "E2E_CLIENT_OPERADOR_PASSWORD"
        }
      },
      {
        "role": "operador_creas",
        "credentials_env": {
          "cpf": "E2E_CLIENT_CREAS_OPERADOR_CPF",
          "password": "E2E_CLIENT_CREAS_OPERADOR_PASSWORD"
        }
      }
    ],
    "state": [
      "Massa do seeder do plano 03: família …11293001 com acompanhamento PAEFI no CREAS de 03/2026 a 07/2026 (derivado) e sem período manual; família …11293002 com acompanhamento PAEFI em curso e sem período manual",
      "Operador do CRAS Centro como técnico, com uma única unidade de registro; operador do CREAS lotado no CREAS",
      "Os períodos manuais extras são removidos a cada rodada do seeder; happy_path roda antes das demais variantes na mesma massa",
      "A família é identificada pelo uuid fixo do seeder (padrão …000011293001), como nas demais HUs da sprint"
    ]
  },
  "data": {
    "family_uuid": "00000000-0000-4000-8000-000011293001",
    "empty_family_uuid": "00000000-0000-4000-8000-000011293002"
