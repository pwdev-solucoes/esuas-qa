          },
          "timeout_ms": 10000,
          "note": "o acolhimento reaparece na lista"
        }
      ],
      "assertions": [
        {
          "expect": "text",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"sheltering-row-\"]:has-text(\"E2E Joana Adulta\") >> nth=0"
