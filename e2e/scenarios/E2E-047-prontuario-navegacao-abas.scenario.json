        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "[data-testid=\"family-tab-resumo\"][aria-selected=\"true\"]"
          },
          "note": "leitura ausente: volta ao Resumo"
        }
      ]
    }
  ],
  "not_applicable": {
