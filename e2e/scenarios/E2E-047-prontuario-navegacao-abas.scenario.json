            "value": "family-record-nav"
          },
          "timeout_ms": 15000,
          "note": "prontuário carregado"
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "family-tab-resumo"
          }
        },
        {
          "action": "press",
          "key": "ArrowRight",
          "note": "move o foco para a próxima seção (Composição)"
        },
        {
          "action": "press",
          "key": "Enter",
          "note": "ativa a seção focada"
        }
      ],
      "assertions": [
        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "[data-testid=\"family-tab-composicao\"][aria-selected=\"true\"]"
          }
        },
        {
          "expect": "url",
          "value": "tab=composicao"
        }
      ]
    },
    {
