        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "goto",
          "value": "/app/cadastros/familias/${data.family_uuid}?tab=composicao"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "deixa o modal de novidades abrir antes de fechá-lo"
        },
        {
          "action": "press",
          "key": "Escape"
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"member-series-table\"]"
          },
          "timeout_ms": 15000
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button[data-testid^=\"member-conditions-\"] >> nth=0"
