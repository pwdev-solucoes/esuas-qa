          "timeout_ms": 15000,
          "note": "alerta da saúde bloqueada"
        }
      ],
      "assertions": [
        {
          "expect": "text",
          "target": {
            "by": "testid",
            "value": "member-conditions-health_conditions-restricted"
          },
          "value": "${data.health_reason}",
          "note": "motivo único (CA12)"
        },
        {
          "expect": "count",
          "target": {
            "by": "testid",
            "value": "member-conditions-health_conditions-restricted"
          },
          "value": 1,
          "note": "um único alerta"
        },
        {
          "expect": "disabled",
          "target": {
            "by": "testid",
            "value": "member-conditions-save"
          },
          "note": "Salvar condições desabilitado (CA12)"
        }
      ]
    },
    {
