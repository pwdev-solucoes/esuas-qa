            "by": "testid",
            "value": "follow-up-plan-actions"
          },
          "value": " "
        },
        {
          "action": "fill",
          "target": {
            "by": "testid",
            "value": "follow-up-plan-strategies"
          },
          "value": " "
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "follow-up-plan-submit"
          }
        },
        {
          "action": "wait",
          "timeout_ms": 800,
          "note": "a validação é local; nada é enviado"
        }
      ],
      "assertions": [
        {
          "expect": "visible",
          "target": {
            "by": "testid",
            "value": "follow-up-plan-fields-error"
