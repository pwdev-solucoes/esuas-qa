          "value": "3",
          "note": "h · cômodos"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-bedrooms_count\"]"
          },
          "value": "2",
          "note": "i · dormitórios"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-home_accessibility_type\"]"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "option",
            "name": "tanto nos espaços internos"
          },
          "note": "k · acessibilidade"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-condition-risk-area-no\"]"
          },
          "note": "l · área de risco: Não"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-difficult_geographic_access-no\"]"
          },
          "note": "m · difícil acesso: Não"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-area_conflict_violence-yes\"]"
          },
          "note": "n · conflito/violência: Sim"
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-persons-per-bedroom\"]:has-text(\"2,5\")"
          },
          "note": "j · 5 integrantes ÷ 2 dormitórios = 2,5, calculado (CA02)"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[data-testid=\"diagnosis-snapshot-submit\"]"
          }
        },
        {
          "action": "wait",
          "timeout_ms": 3000,
          "note": "espera o POST terminar e a série recarregar"
        }
      ],
      "assertions": [
        {
          "expect": "hidden",
          "target": {
            "by": "css",
            "value": "[data-testid=\"diagnosis-snapshot-form-sheet\"]"
          },
          "note": "retrato gravado, formulário fechado (CA01)"
        },
        {
          "expect": "text",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-condition-block\"] [data-testid=\"snapshot-value-rooms_count\"] >> nth=0"
          },
          "value": "3",
          "note": "retrato mais novo traz os 3 cômodos (CA01)"
        },
        {
          "expect": "text",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-condition-block\"] [data-testid=\"snapshot-value-bedrooms_count\"] >> nth=0"
          },
          "value": "2",
          "note": "e os 2 dormitórios (CA01)"
        },
        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-condition-block\"] [data-testid=\"snapshot-change-marker\"] >> nth=0"
          },
          "note": "itens novos marcados como mudou (CA01)"
        },
        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-condition-block\"] [data-testid^=\"snapshot-column-\"] >> nth=1"
          },
          "note": "o retrato anterior permanece (CA01)"
        }
      ]
    },
