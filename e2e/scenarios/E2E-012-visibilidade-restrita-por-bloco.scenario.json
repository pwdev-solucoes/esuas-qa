{
  "schema_version": 1,
  "id": "E2E-012",
  "title": "Visibilidade restrita por bloco: o CREAS lê as anotações de violência que registrou e o CRAS Centro não vê (nem sabe) que existem",
  "description": "HU #11227 (US-VISIB-01): o bloco de violência e violações de direitos é lido só pela unidade que o registrou. O operador do CREAS vê as anotações de violência do CREAS; o operador do CRAS Centro, que referencia a família, vê só o Geral e a Saúde, com total (2) e o filtro de violência no estado vazio, sem nenhum indício de conteúdo restrito. Massa fictícia (E2EBlockVisibilitySeeder); nenhum dado pessoal.",
  "feature_slug": "11227-visibilidade-bloco-03-evidencias",
  "ac_refs": [
    "AC-002",
    "AC-003"
  ],
  "priority": "P1",
  "tags": [
    "client",
    "prontuario",
    "anotacoes",
    "visibilidade",
    "lgpd"
  ],
  "preconditions": {
    "base_url_env": "CLIENT_BASE_URL",
    "start_path": "/login",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "users": [
      {
        "role": "operador_creas",
        "credentials_env": {
          "cpf": "E2E_CLIENT_CREAS_OPERADOR_CPF",
          "password": "E2E_CLIENT_CREAS_OPERADOR_PASSWORD"
        }
      },
      {
        "role": "operador",
        "credentials_env": {
          "cpf": "E2E_CLIENT_OPERADOR_CPF",
          "password": "E2E_CLIENT_OPERADOR_PASSWORD"
        }
      }
    ],
    "state": [
      "Massa do E2EBlockVisibilitySeeder: família referenciada no CRAS Centro, com PAEFI do CREAS vigente e quatro anotações do CREAS (violência antiga, violência de ontem, geral e saúde)",
      "Operador do CREAS com add-on lotado no CREAS; operador do CRAS Centro com add-on lotado no CRAS Centro",
      "API e client com os planos 01 e 02 da HU #11227"
    ]
  },
  "data": {
    "family_uuid": "00000000-0000-4000-8000-0000000f0015"
  },
  "variants": [
    {
      "name": "happy_path",
      "title": "O operador do CREAS lê as duas anotações de violência que o CREAS registrou (CA01)",
      "as_user": "operador_creas",
      "steps": [
        {
          "action": "goto",
          "value": "/auth/login"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#cpf"
          },
          "value": "${env:E2E_CLIENT_CREAS_OPERADOR_CPF}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#password"
          },
          "value": "${env:E2E_CLIENT_CREAS_OPERADOR_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button[type=\"submit\"]"
          }
        },
        {
          "action": "wait",
          "value": "/app",
          "note": "login concluído: espera a URL autenticada em vez de tempo fixo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto (abre com atraso depois de cada navegação)"
        },
        {
          "action": "goto",
          "value": "/app/cadastros/familias/${data.family_uuid}?tab=anotacoes"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "deixa o modal de novidades abrir antes de fechá-lo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        }
      ],
      "assertions": [
        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "[data-testid=\"family-note-item\"]:has-text(\"E2E 11227 — violência (ontem)\") >> nth=0"
          },
          "note": "anotação de violência recente, lida pela unidade que a registrou"
        },
        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "[data-testid=\"family-note-item\"]:has-text(\"E2E 11227 — violência (anterior\") >> nth=0"
          },
          "note": "anotação de violência anterior à regra também é lida pelo CREAS"
        },
        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "[data-testid=\"family-note-item\"]:has-text(\"E2E 11227 — geral\") >> nth=0"
          }
        },
        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "[data-testid=\"family-note-item\"]:has-text(\"E2E 11227 — saúde\") >> nth=0"
          }
        }
      ]
    },
    {
      "name": "forbidden",
      "title": "O operador do CRAS Centro filtra por violência e a lista fica vazia, sem indício de conteúdo restrito; Geral e Saúde seguem visíveis (CA02, CA04)",
      "as_user": "operador",
      "steps": [
        {
          "action": "goto",
          "value": "/auth/login"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#cpf"
          },
          "value": "${env:E2E_CLIENT_OPERADOR_CPF}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#password"
          },
          "value": "${env:E2E_CLIENT_OPERADOR_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button[type=\"submit\"]"
          }
        },
        {
          "action": "wait",
          "value": "/app",
          "note": "login concluído: espera a URL autenticada em vez de tempo fixo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto (abre com atraso depois de cada navegação)"
        },
        {
          "action": "goto",
          "value": "/app/cadastros/familias/${data.family_uuid}?tab=anotacoes"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "deixa o modal de novidades abrir antes de fechá-lo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"family-note-item\"]:has-text(\"E2E 11227 — geral\") >> nth=0"
          },
          "timeout_ms": 10000,
          "note": "Geral e Saúde carregaram: o total sem filtro já está na tela"
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "family-note-filter-block"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "option",
            "name": "Violência e violações de direitos",
            "exact": true
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "testid",
            "value": "family-notes-empty-filtered"
          },
          "timeout_ms": 10000,
          "note": "o filtro de violência termina no estado vazio"
        }
      ],
      "assertions": [
        {
          "expect": "visible",
          "target": {
            "by": "testid",
            "value": "family-notes-empty-filtered"
          }
        },
        {
          "expect": "text",
          "target": {
            "by": "testid",
            "value": "family-notes-block"
          },
          "value": "(0)",
          "note": "nenhuma anotação de violência legível pelo CRAS Centro"
        },
        {
          "expect": "count",
          "target": {
            "by": "testid",
            "value": "family-note-item"
          },
          "value": 0,
          "note": "a evidência é a ausência: nem a recente nem a anterior aparecem"
        },
        {
          "expect": "count",
          "target": {
            "by": "testid",
            "value": "family-notes-load-error"
          },
          "value": 0
        }
      ]
    }
  ]
}
