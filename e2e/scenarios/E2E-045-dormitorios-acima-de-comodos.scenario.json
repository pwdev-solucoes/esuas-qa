{
  "schema_version": 1,
  "id": "E2E-045",
  "title": "Dormitórios acima de cômodos: aviso, conferência e confirmação na Lima",
  "description": "HU #11407 (US-AJ-10), plano 01: o Operacional abre a série de habitação da família 'E2E Dormitórios Lima' (massa do E2EHousingBedroomsSeeder, sem retrato de habitação). Com 5 cômodos e 2 dormitórios salva sem aviso nem diálogo (happy_path). Com 5 e 6 o campo avisa sem bloquear; ao salvar o servidor pede conferência, e 'Conferi, salvar assim' grava a série com 6 (confirm_incoherent) enquanto 'Voltar e corrigir' mantém o formulário aberto sem gravar (back_to_fix). Execução e massa ficam no plano 02. Massa fictícia; nenhum dado pessoal.",
  "feature_slug": "11407-dormitorios-01-api-client",
  "ac_refs": [
    "AC-006",
    "AC-007"
  ],
  "priority": "P1",
  "tags": [
    "client",
    "prontuario",
    "habitacao",
    "diagnostico",
    "lgpd"
  ],
  "preconditions": {
    "base_url_env": "CLIENT_BASE_URL",
    "start_path": "/login",
    "viewport": {
      "width": 1440,
      "height": 1000
    },
    "users": [
      {
        "role": "operador",
        "credentials_env": {
          "cpf": "E2E_CLIENT_OPERADOR_CPF",
          "password": "E2E_CLIENT_OPERADOR_PASSWORD"
        }
      }
    ],
    "state": [
      "Massa do E2EHousingBedroomsSeeder (plano 02): família 'E2E Dormitórios Lima' (00000000-0000-4000-8000-000011407001) no CRAS Centro, sem retrato de habitação",
      "Operador com add-on lotado no CRAS Centro",
      "As variantes happy_path e confirm_incoherent GRAVAM um retrato por execução; o seeder do plano 02 restaura a família sem retrato"
    ]
  },
  "data": {
    "family_lima_uuid": "00000000-0000-4000-8000-000011407001",
    "unit_name": "E2E CRAS Centro"
  },
  "variants": [
    {
      "name": "happy_path",
      "title": "Cinco cômodos e dois dormitórios salvam sem aviso nem diálogo (CA01)",
      "as_user": "operador",
      "steps": [
        {
          "action": "goto",
          "value": "/auth/login"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#cpf"
          },
          "value": "${env:E2E_CLIENT_OPERADOR_CPF}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#password"
          },
          "value": "${env:E2E_CLIENT_OPERADOR_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button[type=\"submit\"]"
          }
        },
        {
          "action": "wait",
          "value": "/app",
          "note": "login concluído: espera a URL autenticada em vez de tempo fixo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "goto",
          "value": "/app/cadastros/familias/${data.family_lima_uuid}?tab=habitacao"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "deixa o modal de novidades abrir antes de fechá-lo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-condition-block\"]"
          },
          "timeout_ms": 15000,
          "note": "bloco de habitação carregou"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-condition-block\"] [data-testid=\"snapshot-register\"]"
          },
          "note": "série vazia: registrar o primeiro retrato"
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"diagnosis-snapshot-form-sheet\"]"
          },
          "note": "formulário aberto"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[data-testid=\"diagnosis-snapshot-unit-select\"]"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "option",
            "name": "${data.unit_name}"
          }
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-rooms_count\"]"
          },
          "value": "5",
          "note": "h · cômodos"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-bedrooms_count\"]"
          },
          "value": "2",
          "note": "i · dormitórios"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[data-testid=\"diagnosis-snapshot-submit\"]"
          }
        },
        {
          "action": "wait",
          "timeout_ms": 3000,
          "note": "espera a resposta do servidor"
        }
      ],
      "assertions": [
        {
          "expect": "hidden",
          "target": {
            "by": "css",
            "value": "[data-testid=\"diagnosis-snapshot-form-sheet\"]"
          },
          "note": "salvou direto, formulário fechado (CA01)"
        },
        {
          "expect": "hidden",
          "target": {
            "by": "css",
            "value": "[data-testid=\"snapshot-write-confirmation-dialog\"]"
          },
          "note": "sem diálogo de conferência"
        },
        {
          "expect": "hidden",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-bedrooms-warning\"]"
          },
          "note": "sem aviso de dormitórios"
        },
        {
          "expect": "text",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-condition-block\"] [data-testid=\"snapshot-value-bedrooms_count\"] >> nth=0"
          },
          "value": "2",
          "note": "série com 2 dormitórios"
        }
      ]
    },
