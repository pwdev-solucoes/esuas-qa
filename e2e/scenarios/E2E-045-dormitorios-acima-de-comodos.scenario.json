          }
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"snapshot-write-confirmation-dialog\"]"
          },
          "note": "servidor pediu conferência; nada gravado"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[data-testid=\"snapshot-write-confirmation-confirm\"]"
          }
        },
        {
          "action": "wait",
          "timeout_ms": 3000,
