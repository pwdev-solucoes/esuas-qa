            "by": "css",
            "value": "[data-testid=\"violence-record-item\"]:has-text(\"Indício\"):has-text(\"09/2026\"):not(:has([data-testid=\"violence-record-confirmed-badge\"])) [data-testid=\"violence-record-confirm\"] >> nth=0"
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "testid",
            "value": "violence-record-form-sheet"
          },
          "timeout_ms": 10000
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "violence-record-month-select"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "option",
            "name": "Outubro",
            "exact": true
          }
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "violence-record-submit"
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "testid",
            "value": "violence-record-confirmed-badge"
