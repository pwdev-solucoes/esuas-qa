{
  "schema_version": 1,
  "id": "E2E-030",
  "title": "Registro obrigatório do CREAS (Quadro 3): registrar indício, confirmar, validar, leitura sem ação e vazio",
  "description": "HU #11292 (US-VIOL-03), plano 02: na aba Violência, o operador do CREAS registra o indício de violência psicológica para a pessoa vitimada e depois o confirma (os dois continuam listados, com selo e assinatura), vê o lembrete do instrumento e o aviso de leitura do servidor e é barrado ao escolher \"Outra\" sem descrição. O técnico do CRAS lê o registro, mas não tem as ações de escrita. Família sem registro mostra a frase única. Massa fictícia (E2EViolenceRecordSeeder, plano 03); nenhum dado pessoal real.",
  "feature_slug": "11292-quadro3-02-client",
  "ac_refs": [
    "AC-001",
    "AC-002",
    "AC-003",
    "AC-006",
    "AC-009"
  ],
  "priority": "P1",
  "tags": [
    "client",
    "prontuario",
    "violencia",
    "creas",
    "quadro-3",
    "sigilo"
  ],
  "preconditions": {
    "base_url_env": "CLIENT_BASE_URL",
    "start_path": "/login",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "users": [
      {
        "role": "operador_creas",
        "credentials_env": {
          "cpf": "E2E_CLIENT_CREAS_OPERADOR_CPF",
          "password": "E2E_CLIENT_CREAS_OPERADOR_PASSWORD"
        }
      },
      {
        "role": "operador_cras",
        "credentials_env": {
          "cpf": "E2E_CLIENT_OPERADOR_CPF",
          "password": "E2E_CLIENT_OPERADOR_PASSWORD"
        }
      }
    ],
    "state": [
      "Massa do E2EViolenceRecordSeeder (plano 03): família …11292001 acompanhada pelo CREAS com a integrante \"E2E Quadro3 Ana\" e um registro semeado legível pelo CRAS Centro; família …11292002 sem registro",
      "Operador do CREAS lotado no CREAS com a função Assistente social (nome E2E Operador CREAS); operador do CRAS Centro como técnico",
      "Os registros extras da família são removidos a cada rodada do seeder; happy_path roda antes das demais variantes na mesma massa",
      "API e client com os planos 01 e 02 da HU #11292; o mês 09/2026 é o indício e 10/2026 a confirmação (11/2026 é futuro na data da execução)"
    ]
  },
  "data": {
    "family_uuid": "00000000-0000-4000-8000-000011292001",
    "empty_family_uuid": "00000000-0000-4000-8000-000011292002"
  },
  "variants": [
    {
      "name": "happy_path",
      "title": "O CREAS registra o indício de violência psicológica para a pessoa vitimada e depois a confirma: os dois ficam listados, com selo e assinatura (CA01/CA02)",
      "as_user": "operador_creas",
      "steps": [
        {
          "action": "goto",
          "value": "/auth/login"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#cpf"
          },
          "value": "${env:E2E_CLIENT_CREAS_OPERADOR_CPF}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#password"
          },
          "value": "${env:E2E_CLIENT_CREAS_OPERADOR_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button[type=\"submit\"]"
          }
        },
        {
          "action": "wait",
          "value": "/app",
          "note": "login concluído: espera a URL autenticada em vez de tempo fixo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto (abre com atraso depois de cada navegação)"
        },
        {
          "action": "goto",
          "value": "/app/cadastros/familias/${data.family_uuid}?tab=violencia"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "deixa o modal de novidades abrir antes de fechá-lo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "wait",
          "target": {
            "by": "testid",
            "value": "violence-records-section"
          },
          "timeout_ms": 15000,
          "note": "Quadro 3 carregado"
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "violence-records-register"
          }
        },
        {
          "action": "wait",
