        },
        {
          "expect": "count",
          "target": {
            "by": "testid",
            "value": "collective-activity-participants"
          },
          "value": 0,
          "note": "nenhum participante adicionado"
        },
        {
          "expect": "disabled",
          "target": {
            "by": "testid",
            "value": "collective-activity-search-submit"
          },
          "note": "sem critério a busca fica desabilitada (CA02)"
        }
      ]
