{
  "schema_version": 1,
  "id": "E2E-042",
  "title": "Atividade coletiva no menu: registrar com três participantes de famílias distintas, sem lista antes da busca, sem participantes barrado e menu ausente sem o add-on",
  "description": "HU #11404 (US-AJ-07), plano 02: o operador do CRAS Centro abre Atividades Coletivas, registra uma atividade buscando 'E2E Coletiva' e adicionando três pessoas de famílias diferentes, e vê o resumo com três atendimentos e o atalho de cada prontuário (CA01). A página de registro abre sem lista de pessoas e com a busca desabilitada (CA02, variante empty_state). Salvar sem participantes é barrado na tela (variante validation_error). Quem não tem o add-on do prontuário familiar não vê o item no menu (variante forbidden). A massa vem do E2ECollectiveActivitySeeder (plano 03); credenciais só por variável de ambiente. Massa fictícia; nenhum dado pessoal.",
  "feature_slug": "11404-coletiva-02-client",
  "ac_refs": [
    "AC-001",
    "AC-002",
    "AC-005",
    "AC-007"
  ],
  "priority": "P1",
  "tags": [
    "client",
    "prontuario",
    "atividade-coletiva",
    "lgpd"
  ],
  "preconditions": {
    "base_url_env": "CLIENT_BASE_URL",
    "start_path": "/login",
    "viewport": {
      "width": 1440,
      "height": 1000
    },
    "users": [
      {
        "role": "operador",
        "credentials_env": {
          "cpf": "E2E_CLIENT_OPERADOR_CPF",
          "password": "E2E_CLIENT_OPERADOR_PASSWORD"
        }
      },
      {
        "role": "sem_addon",
        "credentials_env": {
          "cpf": "E2E_CLIENT_NO_ADDON_CPF",
          "password": "E2E_CLIENT_NO_ADDON_PASSWORD"
        }
      }
    ],
    "state": [
      "Massa do E2ECollectiveActivitySeeder (plano 03): famílias 'E2E Coletiva Alves Ana', 'E2E Coletiva Barros Davi' e 'E2E Coletiva Campos Elisa' no CRAS Centro, uma pessoa por família",
      "Operador com add-on lotado no CRAS Centro; usuário sem add-on lotado no mesmo CRAS (E2EProntuarioSeeder)",
      "A variante happy_path GRAVA uma atividade e três atendimentos por execução; as asserções são pelo resumo da própria execução, nunca por contagem absoluta"
    ]
  },
  "data": {
    "unit_name": "E2E CRAS Centro"
  },
  "variants": [
    {
      "name": "happy_path",
      "title": "Operador registra a atividade com três participantes e vê o resumo com três atendimentos (CA01)",
      "as_user": "operador",
      "steps": [
        {
          "action": "goto",
          "value": "/auth/login"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#cpf"
          },
          "value": "${env:E2E_CLIENT_OPERADOR_CPF}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#password"
          },
          "value": "${env:E2E_CLIENT_OPERADOR_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button[type=\"submit\"]"
          }
        },
        {
          "action": "wait",
          "value": "/app",
          "note": "login concluído: espera a URL autenticada em vez de tempo fixo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "goto",
          "value": "/app/atividades-coletivas"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "deixa o modal de novidades abrir antes de fechá-lo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "wait",
          "target": {
            "by": "testid",
            "value": "collective-activities-page"
          },
          "timeout_ms": 15000,
          "note": "a relação carregou"
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "collective-activity-new"
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "testid",
            "value": "collective-activity-form"
          },
          "timeout_ms": 15000,
          "note": "a página de registro abriu"
        },
        {
          "action": "wait",
          "target": {
            "by": "testid",
            "value": "collective-activity-search-name"
          },
          "timeout_ms": 15000
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "collective-activity-unit"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "option",
            "name": "${data.unit_name}"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "collective-activity-type"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[role=\"option\"] >> nth=0"
          },
          "note": "primeiro tipo ativo"
        },
        {
          "action": "fill",
          "target": {
            "by": "testid",
            "value": "collective-activity-description"
          },
          "value": "Roda de conversa E2E sobre acesso a benefícios."
        },
        {
          "action": "fill",
          "target": {
            "by": "testid",
            "value": "collective-activity-search-name"
          },
          "value": "E2E Coletiva"
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "collective-activity-search-submit"
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "testid",
            "value": "collective-activity-search-results"
          },
          "timeout_ms": 15000,
          "note": "a busca respondeu"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "li:has-text(\"E2E Coletiva Alves Ana\") [data-testid=\"collective-activity-add-participant\"]"
          },
          "note": "adiciona E2E Coletiva Alves Ana"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "li:has-text(\"E2E Coletiva Barros Davi\") [data-testid=\"collective-activity-add-participant\"]"
          },
          "note": "adiciona E2E Coletiva Barros Davi"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "li:has-text(\"E2E Coletiva Campos Elisa\") [data-testid=\"collective-activity-add-participant\"]"
          },
          "note": "adiciona E2E Coletiva Campos Elisa"
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "collective-activity-submit"
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "testid",
            "value": "collective-activity-summary"
          },
          "timeout_ms": 20000,
          "note": "atividade registrada: resumo na tela"
        }
      ],
      "assertions": [
        {
          "expect": "visible",
          "target": {
            "by": "testid",
            "value": "collective-activity-summary"
          },
          "note": "resumo persistente (CA01)"
        },
        {
          "expect": "text",
          "target": {
            "by": "testid",
            "value": "collective-activity-summary"
          },
          "value": "3 atendimento(s) gerado(s)",
          "note": "um atendimento por família (CA01)"
        },
        {
          "expect": "count",
          "target": {
            "by": "css",
            "value": "[data-testid=\"collective-activity-summary\"] [data-testid=\"collective-activity-family\"]"
          },
          "value": 3,
          "note": "atalho para o prontuário das três famílias"
        }
      ]
    },
