          }
        },
        {
          "action": "wait",
          "timeout_ms": 1500,
          "note": "aguarda a relação responder 403"
        }
      ],
      "assertions": [
        {
          "expect": "url",
          "value": "/app/cadastros/acompanhamentos-atencao"
        },
        {
          "expect": "visible",
          "target": {
            "by": "testid",
            "value": "follow-ups-attention-missing-addon"
