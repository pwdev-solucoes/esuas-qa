          "note": "estado de acesso ao prontuário familiar"
        },
        {
          "expect": "count",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"follow-up-attention-row-\"]"
          },
          "value": 0,
          "note": "nenhuma família listada"
        }
      ]
    }
  ]
}
