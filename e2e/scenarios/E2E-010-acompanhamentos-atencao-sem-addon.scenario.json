{
  "schema_version": 1,
  "id": "E2E-010",
  "title": "Acompanhamentos que pedem atenção sem o add-on do prontuário: a apuração mostra a contagem e a relação nega com o motivo",
  "description": "HU #11209 (US-EVOL-02), plano 03: o Operacional sem add-on vê na apuração o aviso com a contagem e o link Ver quais são; o link abre a relação, que mostra o estado de acesso ao prontuário familiar em vez de listar famílias. Massa fictícia; nenhum dado pessoal.",
  "feature_slug": "11209-acompanhamentos-atencao-03-qa-e2e",
  "ac_refs": [
    "AC-004"
  ],
  "priority": "P1",
  "tags": [
    "client",
    "prontuario",
    "acompanhamento",
    "atencao",
    "lgpd",
    "addon"
  ],
  "preconditions": {
    "base_url_env": "CLIENT_BASE_URL",
    "start_path": "/login",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "users": [
      {
        "role": "sem_addon",
        "credentials_env": {
          "cpf": "E2E_CLIENT_NO_ADDON_CPF",
          "password": "E2E_CLIENT_NO_ADDON_PASSWORD"
        }
      }
    ],
    "state": [
      "Operador lotado no CRAS Centro SEM o add-on do prontuário familiar (E2EProntuarioSeeder)",
      "Massa do E2EFollowUpAttentionSeeder: ao menos um acompanhamento sem planejamento no CRAS Centro",
      "A API recusa a relação com 403 genérico; a tela traduz no estado de acesso ao prontuário"
    ]
  },
  "data": {
    "unit_centro": "00000000-0000-4000-8000-0000000e0001"
  },
  "variants": [
    {
      "name": "happy_path",
      "title": "Sem add-on: contagem na apuração e relação com o estado de acesso (CA10)",
      "as_user": "sem_addon",
      "steps": [
        {
          "action": "goto",
          "value": "/auth/login"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#cpf"
          },
          "value": "${env:E2E_CLIENT_NO_ADDON_CPF}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#password"
          },
          "value": "${env:E2E_CLIENT_NO_ADDON_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button[type=\"submit\"]"
          }
        },
        {
          "action": "wait",
          "value": "/app",
          "note": "login concluído: espera a URL autenticada em vez de tempo fixo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "goto",
          "value": "/app/prestacao-contas/apuracao-atendimentos"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "deixa o modal de novidades abrir antes de fechá-lo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "aguarda a apuração carregar"
        }
      ],
      "assertions": [
        {
          "expect": "visible",
          "target": {
            "by": "testid",
            "value": "follow-ups-without-plan-count-${data.unit_centro}"
          },
          "note": "a contagem aparece na apuração, que é anônima"
        },
        {
          "expect": "visible",
          "target": {
            "by": "testid",
            "value": "follow-ups-without-plan-link-${data.unit_centro}"
          },
          "note": "link Ver quais são"
        }
      ]
    },
    {
      "name": "forbidden",
      "title": "Sem add-on: a relação mostra o estado de acesso ao prontuário (CA10)",
      "as_user": "sem_addon",
      "steps": [
        {
