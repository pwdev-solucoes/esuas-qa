  "variants": [
    {
      "name": "happy_path",
      "title": "O técnico registra Liberdade assistida para o adolescente de 16 anos, responde que o CREAS acompanha, e a medida entra na lista com período, processo e assinatura (CA01/CA04)",
      "as_user": "operador",
      "steps": [
        {
          "action": "goto",
          "value": "/app/cadastros/familias/${data.family_uuid}?tab=medidas-socioeducativas"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "deixa o modal de novidades abrir antes de fechá-lo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "wait",
          "target": {
            "by": "testid",
            "value": "socio-educational-measure-block"
          },
          "timeout_ms": 15000,
          "note": "aba Medidas socioeducativas carregada"
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "socio-educational-measure-register-action"
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "testid",
            "value": "socio-educational-measure-form-sheet"
          },
          "timeout_ms": 10000
        },
        {
          "action": "wait",
          "target": {
            "by": "testid",
            "value": "socio-educational-measure-form-notice"
          },
          "timeout_ms": 10000,
          "note": "aviso de sigilo do servidor (S4)"
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "socio-educational-measure-form-member"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "option",
            "name": "E2E Pedro MSE",
            "exact": true
          }
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "socio-educational-measure-form-type"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "option",
            "name": "Liberdade assistida (LA)",
            "exact": true
          }
        },
        {
          "action": "fill",
          "target": {
            "by": "testid",
            "value": "socio-educational-measure-form-process"
          },
          "value": "0001234-75.2026.8.02.0001"
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "socio-educational-measure-form-started-month"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "option",
            "name": "Janeiro",
            "exact": true
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "testid",
            "value": "socio-educational-measure-creas"
          },
          "timeout_ms": 5000,
          "note": "LA pergunta pelo CREAS"
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "socio-educational-measure-creas-yes"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "socio-educational-measure-form-submit"
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"socio-educational-measure-row-\"]:has-text(\"Liberdade assistida (LA)\"):has-text(\"0001234-75.2026.8.02.0001\")"
          },
          "timeout_ms": 10000,
          "note": "a medida reaparece na lista do integrante"
        }
      ],
      "assertions": [
        {
          "expect": "text",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"socio-educational-measure-row-\"]:has-text(\"Liberdade assistida (LA)\") >> nth=0"
          },
          "value": "em curso"
        },
        {
          "expect": "text",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"socio-educational-measure-row-\"]:has-text(\"Liberdade assistida (LA)\") >> nth=0"
          },
          "value": "Acompanhada pelo CREAS: Sim"
        },
        {
          "expect": "text",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"socio-educational-measure-row-\"]:has-text(\"Liberdade assistida (LA)\") [data-testid^=\"socio-educational-measure-signature-\"] >> nth=0"
          },
          "value": "Registrado por"
        },
        {
          "expect": "count",
          "target": {
            "by": "testid",
            "value": "socio-educational-measure-warnings"
          },
          "value": 0,
          "note": "16 anos: sem aviso de idade"
        }
      ]
