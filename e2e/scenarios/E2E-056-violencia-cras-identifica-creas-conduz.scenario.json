          "target": {
            "by": "testid",
            "value": "violence-history-section"
          },
          "timeout_ms": 15000,
          "note": "Quadro 1 carregado"
        }
      ],
      "assertions": [
        {
          "expect": "visible",
          "target": {
            "by": "testid",
            "value": "violence-records-register"
          },
          "note": "Quadro 3: volta a registrar depois do retorno (RN03)"
        },
        {
          "expect": "visible",
          "target": {
            "by": "testid",
            "value": "violence-history-register"
          },
          "note": "Quadro 1: volta a registrar"
        },
        {
          "expect": "hidden",
