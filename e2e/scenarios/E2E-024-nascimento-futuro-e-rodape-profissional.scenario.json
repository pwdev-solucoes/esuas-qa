{
  "schema_version": 1,
  "id": "E2E-024",
  "title": "Novo Profissional: data de nascimento futura recusada pela tela e rodapé sem área em branco",
  "description": "HU #11158 (CA09, CA10, RN06, RN07): a data de nascimento futura digitada é recusada pela aplicação com o texto da API, sem balão do navegador; o input mantém max = hoje; a página não tem rolagem do documento abaixo do rodapé. Massa fictícia; nenhum dado pessoal.",
  "feature_slug": "11158-01-correcoes",
  "ac_refs": [
    "AC-001",
    "AC-002",
    "AC-003",
    "AC-005"
  ],
  "priority": "P1",
  "tags": [
    "client",
    "profissionais",
    "nascimento",
    "rodape"
  ],
  "preconditions": {
    "base_url_env": "CLIENT_BASE_URL",
    "start_path": "/auth/login",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "users": [
      {
        "role": "master",
        "credentials_env": {
          "cpf": "E2E_CLIENT_MASTER_CPF",
          "password": "E2E_CLIENT_MASTER_PASSWORD"
        }
      }
    ],
    "state": [
      "Master com profissional ativo no tenant"
    ]
  },
  "data": {
    "data_futura": "2099-12-31",
    "data_passada": "1990-01-01",
    "mensagem": "A data de nascimento deve ser anterior à data de hoje."
  },
  "variants": [
    {
      "name": "happy_path",
      "title": "Data passada não mostra erro e o input limita a data a hoje (CA09, RN06a)",
      "as_user": "master",
      "steps": [
        {
          "action": "goto",
          "value": "/auth/login"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#cpf"
          },
          "value": "${env:E2E_CLIENT_MASTER_CPF}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#password"
          },
          "value": "${env:E2E_CLIENT_MASTER_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button[type=\"submit\"]"
          }
        },
        {
          "action": "wait",
          "value": "/app",
          "note": "login concluído: espera a URL autenticada"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "goto",
          "value": "/app/cadastros/profissionais-municipais/novo"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "deixa o modal de novidades abrir antes de fechá-lo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input[type=\"date\"]"
          },
          "value": "${data.data_passada}"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button:has-text(\"Salvar profissional\")"
          }
        }
      ],
      "assertions": [
        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "input[type=\"date\"][max]"
          }
        },
        {
          "expect": "count",
          "target": {
            "by": "text",
            "value": "${data.mensagem}"
          },
          "value": 0
        }
      ]
    },
    {
      "name": "validation_error",
      "title": "Data futura digitada é recusada com o texto da API, sem balão nativo (CA09)",
      "as_user": "master",
      "steps": [
        {
          "action": "goto",
          "value": "/auth/login"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#cpf"
          },
          "value": "${env:E2E_CLIENT_MASTER_CPF}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#password"
          },
          "value": "${env:E2E_CLIENT_MASTER_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button[type=\"submit\"]"
          }
        },
        {
          "action": "wait",
          "value": "/app",
          "note": "login concluído: espera a URL autenticada"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "goto",
          "value": "/app/cadastros/profissionais-municipais/novo"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "deixa o modal de novidades abrir antes de fechá-lo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input[type=\"date\"]"
          },
          "value": "${data.data_futura}"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button:has-text(\"Salvar profissional\")"
          }
        }
      ],
      "assertions": [
        {
          "expect": "visible",
          "target": {
            "by": "text",
            "value": "A data de nascimento deve ser anterior à data de hoje."
          }
        },
        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "input[type=\"date\"][aria-invalid=\"true\"]"
          }
        },
        {
          "expect": "count",
          "target": {
            "by": "css",
            "value": "form:not([novalidate])"
          },
          "value": 0
        }
      ]
    }
  ],
  "not_applicable": {
    "forbidden": "O Operador nem enxerga a tela Novo Profissional (exclusiva do Master); a recusa de permissão já é coberta por outras specs e não muda nesta HU.",
    "empty_state": "A tela Novo Profissional é um formulário, sem lista; não há estado vazio."
  }
}
