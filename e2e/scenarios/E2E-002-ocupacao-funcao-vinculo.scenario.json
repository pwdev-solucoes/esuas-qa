        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "option",
            "name": "${data.cbo_outro_label}"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Salvar profissional"
          }
        },
        {
          "action": "wait",
          "timeout_ms": 500
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Cancelar",
            "exact": true
          },
          "note": "o fundo fica aria-hidden com o diálogo aberto"
        },
        {
          "action": "wait",
          "timeout_ms": 500
        }
      ],
      "assertions": [
        {
          "expect": "hidden",
          "target": {
            "by": "text",
            "value": "Alterar a ocupação do profissional?"
          }
        },
        {
          "expect": "url",
          "value": "/app/cadastros/profissionais-municipais/${env:E2E_CLIENT_PROFESSIONAL_CBO_UUID}/editar"
        },
        {
          "expect": "visible",
          "target": {
            "by": "role",
            "value": "button",
            "name": "${data.cbo_outro_label}"
          },
          "note": "formulário mantém a ocupação escolhida"
        }
      ]
    },
