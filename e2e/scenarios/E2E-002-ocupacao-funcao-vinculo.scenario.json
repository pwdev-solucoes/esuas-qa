{
  "schema_version": 1,
  "id": "E2E-002",
  "title": "Ocupação × função no vínculo do profissional",
  "description": "HU #11131: a edição do profissional mostra a ocupação salva e só confirma ao trocá-la ou retirá-la (cancelar não salva); os modais de função partem da ocupação ativa do profissional selecionado, avisam a divergência sem bloquear e exigem a função; o Operacional não vê as ações de vincular. Nomes de profissional vêm de variáveis de ambiente (massa fictícia).",
  "feature_slug": "11131-ocupacao-funcao-vinculo-02-client",
  "ac_refs": [
    "AC-001",
    "AC-003",
    "AC-004",
    "AC-007",
    "AC-009",
    "AC-011"
  ],
  "priority": "P1",
  "tags": [
    "client",
    "professionals",
    "ocupacao-funcao",
    "lgpd"
  ],
  "preconditions": {
    "base_url_env": "CLIENT_BASE_URL",
    "start_path": "/auth/login",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "users": [
      {
        "role": "master",
        "credentials_env": {
          "cpf": "E2E_CLIENT_MASTER_CPF",
          "password": "E2E_CLIENT_MASTER_PASSWORD"
        }
      },
      {
        "role": "operador",
        "credentials_env": {
          "cpf": "E2E_CLIENT_OPERADOR_CPF",
          "password": "E2E_CLIENT_OPERADOR_PASSWORD"
        }
      }
    ],
    "state": [
      "Profissional fictício com a ocupação 2516-05 (Assistente social) ativa no catálogo (E2E_CLIENT_PROFESSIONAL_CBO_UUID)",
      "Unidade de teste (E2E_CLIENT_UNIT_UUID) com dois profissionais elegíveis ao vínculo: um com ocupação 2516-05 ativa (rótulo E2E_CLIENT_CBO_CANDIDATE_LABEL) e um sem ocupação (rótulo E2E_CLIENT_NOCBO_CANDIDATE_LABEL)",
      "O CBO 1422-05 (Gerente de recursos humanos) existe e está ativo no catálogo",
      "Operacional sem professionals.units.manage, com acesso à unidade"
    ]
  },
  "data": {
    "cbo_principal": "2516-05 — Assistente social",
    "cbo_outro": "1422-05",
    "cbo_outro_label": "1422-05 — Gerente de recursos humanos"
  },
  "variants": [
    {
      "name": "happy_path",
      "title": "Edição mostra a ocupação salva; trocar pede confirmação (CA09/CA10)",
      "as_user": "master",
      "steps": [
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#cpf"
          },
          "value": "${env:E2E_CLIENT_MASTER_CPF}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#password"
          },
          "value": "${env:E2E_CLIENT_MASTER_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button[type=\"submit\"]"
          }
        },
        {
          "action": "wait",
          "timeout_ms": 1500,
          "note": "login + gate LGPD"
        },
        {
          "action": "goto",
          "value": "/app/cadastros/profissionais-municipais/${env:E2E_CLIENT_PROFESSIONAL_CBO_UUID}/editar"
        },
        {
          "action": "wait",
          "timeout_ms": 1500,
          "note": "prefill da edição"
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "button",
            "name": "${data.cbo_principal}"
          }
        },
        {
          "action": "fill",
          "target": {
            "by": "placeholder",
            "value": "Buscar por código ou nome..."
          },
          "value": "${data.cbo_outro}"
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "option",
            "name": "${data.cbo_outro_label}"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Salvar profissional"
          }
        },
        {
          "action": "wait",
          "timeout_ms": 500
        }
      ],
      "assertions": [
        {
          "expect": "visible",
          "target": {
            "by": "role",
            "value": "dialog"
          },
          "note": "diálogo de troca (AC-003)"
        },
        {
          "expect": "visible",
          "target": {
            "by": "text",
            "value": "Alterar a ocupação do profissional?"
          }
        }
      ]
    },
    {
