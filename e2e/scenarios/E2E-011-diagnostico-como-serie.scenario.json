{
  "schema_version": 1,
  "id": "E2E-011",
  "title": "Diagnóstico como série: três retratos de habitação com as mudanças marcadas, atualização preenchida e assinada, e data futura bloqueada",
  "description": "HU #11225 (US-SERIE-01), plano 03: o Operacional com add-on abre a aba Condições habitacionais da família S1 (massa do E2EDiagnosisSeriesSeeder), vê três retratos com o marcador Mudou, aciona Alterar, escolhe registrar atualização, confere o formulário preenchido, muda a área de risco e salva: o 4º retrato fica à esquerda, assinado. A variante validation_error confere que o calendário não permite dia posterior a hoje. Correção, aviso de retroatividade, composição sem ação e primeiro registro (S2) estão na spec manual tests/client/diagnosis-series-11225.spec.ts. Massa fictícia; nenhum dado pessoal.",
  "feature_slug": "11225-diagnostico-serie-03-evidencias",
  "ac_refs": [
    "AC-002",
    "AC-003",
    "AC-005"
  ],
  "priority": "P1",
  "tags": [
    "client",
    "prontuario",
    "diagnostico",
    "serie",
    "lgpd"
  ],
  "preconditions": {
    "base_url_env": "CLIENT_BASE_URL",
    "start_path": "/login",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "users": [
      {
        "role": "operador",
        "credentials_env": {
          "cpf": "E2E_CLIENT_OPERADOR_CPF",
          "password": "E2E_CLIENT_OPERADOR_PASSWORD"
        }
      }
    ],
    "state": [
      "Massa do E2EDiagnosisSeriesSeeder: família S1 com três retratos de habitação (hoje-200 d, -90 d, -10 d) no CRAS Centro; S2 sem retrato; remessa SIAP COMPLETED do mês de hoje-60 d",
      "Operador com add-on lotado no CRAS Centro (e no CRAS Sem MDS, por isso a unidade é escolhida no formulário)",
      "A variante happy_path GRAVA um 4º retrato na S1: rodar ANTES da spec manual tests/client/diagnosis-series-11225.spec.ts e reexecutar o seeder (ele poda retratos extras) antes de repetir"
    ]
  },
  "data": {
    "family_s1_uuid": "00000000-0000-4000-8000-0000000f0201",
    "unit_name": "E2E CRAS Centro"
  },
  "variants": [
    {
      "name": "happy_path",
      "title": "Operacional: três retratos com Mudou, pergunta, formulário preenchido e 4º retrato assinado (CA01, CA02, CA03, CA05)",
      "as_user": "operador",
      "steps": [
        {
          "action": "goto",
          "value": "/auth/login"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#cpf"
          },
          "value": "${env:E2E_CLIENT_OPERADOR_CPF}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#password"
          },
          "value": "${env:E2E_CLIENT_OPERADOR_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button[type=\"submit\"]"
          }
        },
        {
          "action": "wait",
          "value": "/app",
          "note": "login concluído: espera a URL autenticada em vez de tempo fixo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "goto",
          "value": "/app/cadastros/familias/${data.family_s1_uuid}?tab=habitacao"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "deixa o modal de novidades abrir antes de fechá-lo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"snapshot-series\"]"
          },
          "timeout_ms": 15000,
          "note": "a série da família S1 carregou"
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"snapshot-column-\"] >> nth=2"
          },
          "note": "três retratos lado a lado (CA05)"
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"snapshot-change-marker\"] >> nth=1"
          },
          "note": "duas mudanças marcadas com Mudou entre os três retratos (CA05)"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"snapshot-alter-\"]"
          },
          "note": "Alterar existe só no retrato mais recente (CA03)"
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"snapshot-change-kind-dialog\"]"
          },
          "note": "o diálogo pergunta antes de abrir qualquer formulário (CA03)"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[data-testid=\"snapshot-kind-update\"]"
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"diagnosis-snapshot-form-sheet\"]"
          },
          "note": "formulário de atualização aberto"
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-condition-residence-type\"]:has-text(\"Cedida\")"
          },
          "note": "formulário nasce preenchido com o tipo do retrato vigente (CA02)"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[data-testid=\"diagnosis-snapshot-unit-select\"]"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "role",
            "value": "option",
            "name": "${data.unit_name}"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[data-testid=\"housing-condition-risk-area-no\"]"
          },
          "note": "muda só a área de risco"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[data-testid=\"diagnosis-snapshot-submit\"]"
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"snapshot-column-\"] >> nth=2"
          },
          "timeout_ms": 15000,
          "note": "a série recarrega com a janela de 3 retratos"
        }
      ],
      "assertions": [
        {
          "expect": "hidden",
          "target": {
            "by": "css",
            "value": "[data-testid=\"diagnosis-snapshot-form-sheet\"]"
          },
          "note": "o formulário fechou após salvar"
        },
        {
          "expect": "count",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"snapshot-column-\"]"
          },
          "value": 3,
          "note": "janela de 3 retratos"
        },
        {
          "expect": "text",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"snapshot-column-\"] >> nth=0"
          },
          "value": "Mais recente",
          "note": "o 4º retrato fica à esquerda (CA01)"
        },
        {
          "expect": "text",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"snapshot-column-\"] >> nth=0"
          },
          "value": "E2E CRAS Centro",
          "note": "assinatura com a unidade (CA01)"
        },
        {
          "expect": "text",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"snapshot-column-\"] >> nth=0 >> [data-testid=\"snapshot-value-in_risk_area\"]"
          },
          "value": "Não",
          "note": "a área de risco mudou para Não"
        },
        {
          "expect": "count",
          "target": {
            "by": "css",
            "value": "[data-testid=\"snapshot-change-marker\"]"
          },
          "value": 3,
          "note": "as três janelas comparam com o seguinte (CA05)"
        }
      ]
    },
    {
      "name": "validation_error",
      "title": "Data futura bloqueada no campo (CA07)",
      "as_user": "operador",
      "steps": [
        {
          "action": "goto",
          "value": "/auth/login"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#cpf"
          },
          "value": "${env:E2E_CLIENT_OPERADOR_CPF}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#password"
          },
          "value": "${env:E2E_CLIENT_OPERADOR_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button[type=\"submit\"]"
          }
        },
        {
          "action": "wait",
          "value": "/app",
          "note": "login concluído: espera a URL autenticada em vez de tempo fixo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "goto",
          "value": "/app/cadastros/familias/${data.family_s1_uuid}?tab=habitacao"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "deixa o modal de novidades abrir antes de fechá-lo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"snapshot-series\"]"
          },
          "timeout_ms": 15000,
          "note": "a série da família S1 carregou"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[data-testid^=\"snapshot-alter-\"]"
          },
          "note": "Alterar existe só no retrato mais recente (CA03)"
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"snapshot-change-kind-dialog\"]"
          },
          "note": "o diálogo pergunta antes de abrir qualquer formulário (CA03)"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "[data-testid=\"snapshot-kind-update\"]"
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"diagnosis-snapshot-form-sheet\"]"
          }
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "#diagnosis-snapshot-taken-on"
          },
          "note": "abre o calendário"
        }
      ],
      "assertions": [
        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "[data-reka-calendar-cell-trigger][data-disabled] >> nth=0"
          },
          "note": "dias posteriores a hoje ficam desabilitados (CA07)"
        },
        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "[data-reka-calendar-cell-trigger][data-today]"
          },
          "note": "hoje segue selecionável"
        }
      ]
    }
  ]
}
