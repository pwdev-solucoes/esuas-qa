          },
          "note": "a guarda da rota barra antes da página (tela global de acesso negado)"
        },
        {
          "expect": "count",
          "target": {
            "by": "role",
            "value": "button",
            "name": "Mapa Consolidado do CREAS"
          },
          "value": 0,
          "note": "ausência: o item não aparece no menu"
        }
      ]
    },
    {
      "name": "validation_error",
