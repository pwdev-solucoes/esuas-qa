        },
        {
          "action": "goto",
          "value": "/app/protecao-especial/mapa-creas?start_month=2026-11&end_month=2026-10"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "deixa o modal de novidades abrir antes de fechá-lo"
        },
        {
          "action": "press",
