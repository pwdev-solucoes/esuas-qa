{
  "schema_version": 1,
  "id": "E2E-020",
  "title": "Saúde completa: o assistente administrativo (não técnico) do CRAS Centro abre o prontuário com a aba Saúde restrita, sem a seção de saúde e sem gestações",
  "description": "HU #11234 (US-DIAG2-05), plano 03. O assistente administrativo do CRAS Centro (lotação sem função técnica, HU #11289; a unidade é a de referência da família) abre o prontuário da 'E2E Silva Saúde': não existe a aba 'Saúde' (CA03) e as telas de Pedro e de Ana não têm a seção de saúde nem as gestações (CA04). A EVIDÊNCIA É A AUSÊNCIA. A marcação de deficiência sem o tipo (CA05) é conferida no payload na spec manual. Massa fictícia; nenhum dado pessoal. Mudança de regra (US-AJ-11 RN03, #11408): a aba Saúde passa a aparecer, só com o aviso restrito; o conteúdo de saúde continua ausente.",
  "feature_slug": "11234-saude-completa-03-evidencias",
  "ac_refs": [
    "AC-005"
  ],
  "priority": "P1",
  "tags": [
    "client",
    "prontuario",
    "saude",
    "lgpd",
    "visibilidade"
  ],
  "preconditions": {
    "base_url_env": "CLIENT_BASE_URL",
    "start_path": "/login",
    "viewport": {
      "width": 1440,
      "height": 1600
    },
    "users": [
      {
        "role": "nao_tecnico",
        "credentials_env": {
          "cpf": "E2E_CLIENT_ADMIN_STAFF_CPF",
          "password": "E2E_CLIENT_ADMIN_STAFF_PASSWORD"
        }
      }
    ],
    "state": [
      "Massa do E2EHealthVisibilitySeeder: assistente administrativo do CRAS Centro (CBO não técnico, E2EConfidentialitySeeder); a leitura do sigilo é da equipe técnica (HU #11289)"
    ]
  },
  "data": {
    "family_uuid": "00000000-0000-4000-8000-0000000f1234",
    "unit_name": "E2E CRAS Centro"
  },
  "variants": [
    {
      "name": "happy_path",
      "title": "O prontuário abre para o não técnico e a aba Saúde aparece com o aviso restrito (CA03)",
      "as_user": "nao_tecnico",
      "steps": [
        {
          "action": "goto",
          "value": "/auth/login"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#cpf"
          },
          "value": "${env:E2E_CLIENT_ADMIN_STAFF_CPF}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#password"
          },
          "value": "${env:E2E_CLIENT_ADMIN_STAFF_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button[type=\"submit\"]"
          }
        },
        {
          "action": "wait",
          "value": "/app",
          "note": "login concluído: espera a URL autenticada em vez de tempo fixo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "goto",
          "value": "/app/cadastros/familias/${data.family_uuid}?tab=saude"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "deixa o modal de novidades abrir antes de fechá-lo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "wait",
          "target": {
            "by": "role",
            "value": "tab",
            "name": "Composição Familiar",
            "exact": true
          },
          "timeout_ms": 15000,
          "note": "o prontuário abriu (eixo do encaminhamento recebido)"
        }
      ],
      "assertions": [
        {
          "expect": "visible",
          "target": {
            "by": "role",
            "value": "tab",
            "name": "Composição Familiar",
            "exact": true
          }
        },
        {
          "expect": "visible",
          "target": {
            "by": "role",
            "value": "tab",
            "name": "Saúde",
            "exact": true
          },
          "note": "US-AJ-11 RN03 (#11408): a aba Saúde aparece, com o aviso restrito"
        },
        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "[data-testid=\"health-restricted\"]"
          },
          "note": "US-AJ-11 RN03 (#11408): aviso fixo no lugar do conteúdo"
        },
        {
          "expect": "count",
          "target": {
            "by": "css",
            "value": "[data-testid=\"health-block\"]"
          },
          "value": 0,
          "note": "nem o conteúdo, mesmo pedindo ?tab=saude"
        }
      ]
    },
    {
      "name": "forbidden",
      "title": "As telas de Pedro e de Ana não têm seção de saúde nem gestações (CA04)",
      "as_user": "nao_tecnico",
      "steps": [
        {
          "action": "goto",
          "value": "/auth/login"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#cpf"
          },
          "value": "${env:E2E_CLIENT_ADMIN_STAFF_CPF}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#password"
          },
          "value": "${env:E2E_CLIENT_ADMIN_STAFF_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button[type=\"submit\"]"
          }
        },
        {
          "action": "wait",
          "value": "/app",
          "note": "login concluído: espera a URL autenticada em vez de tempo fixo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "goto",
          "value": "/app/cadastros/familias/${data.family_uuid}?tab=composicao"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "deixa o modal de novidades abrir antes de fechá-lo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "tr[data-testid^=\"member-row-\"]:has-text(\"E2E Saúde Pedro\") [data-testid^=\"member-conditions-\"]"
          },
          "timeout_ms": 15000
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "tr[data-testid^=\"member-row-\"]:has-text(\"E2E Saúde Pedro\") [data-testid^=\"member-conditions-\"]"
          },
          "note": "drawer de Pedro"
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"member-conditions-drawer\"]"
          },
          "timeout_ms": 15000
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"member-section-work_income_conditions\"]"
          },
          "timeout_ms": 15000,
          "note": "o restante do drawer carregou"
        }
      ],
      "assertions": [
        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "[data-testid=\"member-conditions-drawer\"]"
          }
        },
        {
          "expect": "count",
          "target": {
            "by": "css",
            "value": "[data-testid=\"member-section-health_conditions\"]"
          },
          "value": 0,
          "note": "a evidência é a ausência da seção de saúde"
        },
        {
          "expect": "count",
          "target": {
            "by": "css",
            "value": "[data-testid=\"member-pregnancy-block\"]"
          },
          "value": 0,
          "note": "nem as gestações"
        }
      ]
    }
  ],
  "not_applicable": {
    "validation_error": "Quem não conduz não tem formulário de saúde para validar.",
    "empty_state": "Não há estado vazio: a aba e a seção simplesmente não existem."
  }
}
