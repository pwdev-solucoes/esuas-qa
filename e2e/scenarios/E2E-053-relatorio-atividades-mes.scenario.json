{
  "schema_version": 1,
  "id": "E2E-053",
  "title": "Relatório de Atividades do mês: linhas calculadas e digitadas, salvar só o alterado e impressão com aviso de pendências",
  "description": "HU #11546 (US-RAT-02), plano 02: o técnico do 'E2E CREAS RMA' abre 10/2026 e vê B.6 = 4 calculada (sem campo) e A.1, B.15 e B.16 'Não informado'; digita 6 em B.15, salva e vê 'Informada pela equipe'; com A.1 e B.16 vazias, Imprimir abre o diálogo listando as duas e 'Imprimir mesmo assim' o fecha e baixa o PDF (download não assertado: coberto pelo Vitest e pelo Pest); valor negativo é barrado no campo. Massa do E2EActivityReportMonthSeeder (plano 03); executado no plano 03. Nenhum dado pessoal real.",
  "feature_slug": "11546-rat-mes-02-client",
  "ac_refs": [
    "AC-001",
    "AC-002",
    "AC-004"
  ],
  "priority": "P1",
  "tags": [
    "client",
    "relatorio-atividades",
    "prestacao-contas",
    "creas"
  ],
  "preconditions": {
    "base_url_env": "CLIENT_BASE_URL",
    "start_path": "/login",
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "users": [
      {
        "role": "tecnico",
        "credentials_env": {
          "cpf": "E2E_CLIENT_CREAS_RMA_TECNICO_CPF",
          "password": "E2E_CLIENT_CREAS_RMA_TECNICO_PASSWORD"
        }
      }
    ],
    "state": [
      "Massa do E2EActivityReportMonthSeeder (plano 03): modelo vigente com A.1, B.6 (calculada = 4), B.15 e B.16 (digitadas) e unidade 'E2E CREAS RMA', mês 2026-10, sem valores gravados no início de cada variante",
      "Técnico E2E_CLIENT_CREAS_RMA_TECNICO_* com profissional ativo na unidade e feature_access.activity_report",
      "Rótulos das linhas (A.1, B.6, B.15, B.16) confirmados no plano 03 contra o seeder"
    ]
  },
  "data": {
    "unit_name": "E2E CREAS RMA",
    "reference_month": "2026-10"
  },
  "variants": [
    {
      "name": "happy_path",
      "title": "Abre 10/2026, vê B.6 calculada sem campo, digita 6 em B.15 e salva (CA01, CA02, CA03)",
      "as_user": "tecnico",
      "steps": [
        {
          "action": "goto",
          "value": "/auth/login"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#cpf"
          },
          "value": "${env:E2E_CLIENT_CREAS_RMA_TECNICO_CPF}"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "input#password"
          },
          "value": "${env:E2E_CLIENT_CREAS_RMA_TECNICO_PASSWORD}"
        },
        {
          "action": "click",
          "target": {
            "by": "css",
            "value": "button[type=\"submit\"]"
          }
        },
        {
          "action": "wait",
          "value": "/app",
          "note": "login concluído: espera a URL autenticada em vez de tempo fixo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "goto",
          "value": "/app/prestacao-contas/relatorio-atividades"
        },
        {
          "action": "wait",
          "timeout_ms": 2500,
          "note": "deixa o modal de novidades abrir antes de fechá-lo"
        },
        {
          "action": "press",
          "key": "Escape",
          "note": "fecha o modal de novidades da plataforma, se estiver aberto"
        },
        {
          "action": "fill",
          "target": {
            "by": "testid",
            "value": "activity-report-month"
          },
          "value": "2026-10",
          "note": "mês da massa (o padrão é o mês anterior ao corrente)"
        },
        {
          "action": "wait",
          "target": {
            "by": "testid",
            "value": "activity-report-header"
          },
          "note": "relatório carregado"
        },
        {
          "action": "fill",
          "target": {
            "by": "css",
            "value": "[data-testid=\"activity-report-line\"]:has-text(\"B.15\") [data-testid=\"activity-report-line-input\"]"
          },
          "value": "6"
        },
        {
          "action": "click",
          "target": {
            "by": "testid",
            "value": "activity-report-save"
          }
        },
        {
          "action": "wait",
          "target": {
            "by": "css",
            "value": "[data-testid=\"activity-report-line\"]:has-text(\"B.15\") [data-testid=\"activity-report-line-status\"]"
          },
          "note": "salvo: status da linha atualizado"
        }
      ],
      "assertions": [
        {
          "expect": "text",
          "target": {
            "by": "css",
            "value": "[data-testid=\"activity-report-line\"]:has-text(\"B.6\") [data-testid=\"activity-report-line-value\"]"
          },
          "value": "4",
          "note": "B.6 calculada = 4 (CA01)"
        },
        {
          "expect": "visible",
          "target": {
            "by": "css",
            "value": "[data-testid=\"activity-report-line\"]:has-text(\"B.6\") [data-testid=\"activity-report-line-computed\"]"
          },
          "note": "selo Calculada (CA01)"
        },
        {
          "expect": "count",
          "target": {
            "by": "css",
            "value": "[data-testid=\"activity-report-line\"]:has-text(\"B.6\") [data-testid=\"activity-report-line-input\"]"
          },
          "value": 0,
          "note": "B.6 sem campo (CA03)"
        },
        {
          "expect": "text",
          "target": {
            "by": "css",
            "value": "[data-testid=\"activity-report-line\"]:has-text(\"B.15\") [data-testid=\"activity-report-line-status\"]"
          },
          "value": "Informada pela equipe",
          "note": "B.15 informada (CA02)"
        },
        {
          "expect": "text",
          "target": {
            "by": "css",
            "value": "[data-testid=\"activity-report-line\"]:has-text(\"A.1\") [data-testid=\"activity-report-line-status\"]"
          },
          "value": "Não informado",
          "note": "A.1 segue não informada (CA01)"
        },
        {
          "expect": "disabled",
          "target": {
            "by": "testid",
            "value": "activity-report-save"
          },
          "note": "sem alteração pendente após salvar"
        }
      ]
    },
